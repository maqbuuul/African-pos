# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pos_user:pos_password@localhost:5432/african_pos_dev
DATABASE_READ_URL=postgresql://pos_user:pos_password@localhost:5432/african_pos_dev

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MEILISEARCH ─────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev_master_key_change_in_prod

# ─── AUTH ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
BCRYPT_ROUNDS=12

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── M-PESA (DARAJA) ─────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.africanpos.co/webhooks/mpesa
MPESA_ENV=sandbox

# ─── WHATSAPP (META CLOUD API) ───────────────────────────────────────────────
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# ─── ANTHROPIC (CLAUDE AI) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
AWS_TRANSCRIBE_LANGUAGE=sw-KE

# ─── CLOUDFLARE R2 ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=african-pos-files
R2_PUBLIC_URL=

# ─── KRA eTIMS ───────────────────────────────────────────────────────────────
ETIMS_URL=https://etims-api.kra.go.ke/etims-api
ETIMS_CLIENT_ID=
ETIMS_CLIENT_SECRET=

# ─── FLUTTERWAVE ─────────────────────────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ─── FIREBASE FCM ────────────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ─── SENTRY ──────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── POSTHOG (PRODUCT ANALYTICS) ─────────────────────────────────────────────
# Dev: use PostHog Cloud (posthog.com) — free up to 1M events/month
# Prod: self-host on AWS when cost warrants
POSTHOG_KEY=phc_your_project_key_here
POSTHOG_HOST=https://app.posthog.com
# For web apps (manager, dashboard) — Vite exposes VITE_ prefixed vars to browser
VITE_POSTHOG_KEY=phc_your_project_key_here
VITE_POSTHOG_HOST=https://app.posthog.com

# ─── FIREBASE (FCM + ANALYTICS FOR POS APP) ──────────────────────────────────
# Dev: download google-services.json from Firebase Console → apps/pos/android/app/
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# For client-side (React Native) — stored in google-services.json, not here

# ─── ML SERVICE ──────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET=internal_ml_secret
