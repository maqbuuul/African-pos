# Core
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000

# Database
# DATABASE_URL: schema owner (pos_user, superuser) — migrations, seeding, admin
# tooling only. Never used to serve API requests: superusers bypass Row-Level
# Security unconditionally, so RLS would be decorative if the API used this.
DATABASE_URL=postgresql://pos_user:pos_password@localhost:5432/hospitality_os_dev
# APP_DATABASE_URL: low-privilege runtime role (pos_app, see
# infra/postgres/init.sql) — this is what the API actually connects as for
# every request, so RLS policies are enforced.
APP_DATABASE_URL=postgresql://pos_app:pos_app_password@localhost:5432/hospitality_os_dev
JWT_SECRET=
REDIS_URL=redis://localhost:6379
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev_master_key_change_me

# AI/ML
AI_ML_SERVICE_URL=http://localhost:8000
AI_ML_SERVICE_SECRET=dev_internal_ai_ml_secret_change_me
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Payments
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Messaging
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
AFRICAS_TALKING_API_KEY=

# Product analytics
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

