# Core
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
# PUBLIC_URL: this API's own publicly-reachable base URL — used to build
# absolute callback URLs handed to third parties (split-payment WhatsApp
# links, M-Pesa C2B Validation/Confirmation URL registration). Must be a real
# HTTPS host in any environment that registers M-Pesa C2B URLs — Safaricom
# will not call back to localhost or an ngrok tunnel on a live shortcode.
PUBLIC_URL=https://pay.hospitality-os.app

# Database
# DATABASE_URL: schema owner (pos_user, superuser) — migrations, seeding, admin
# tooling only. Never used to serve API requests: superusers bypass Row-Level
# Security unconditionally, so RLS would be decorative if the API used this.
DATABASE_URL=postgresql://pos_user:pos_password@localhost:5432/hospitality_os_dev
# APP_DATABASE_URL: low-privilege runtime role (pos_app, see
# infra/postgres/init.sql) — this is what the API actually connects as for
# every request, so RLS policies are enforced.
APP_DATABASE_URL=postgresql://pos_app:pos_app_password@localhost:5432/hospitality_os_dev
JWT_SECRET=
# CREDENTIALS_ENCRYPTION_KEY: AES-256-GCM key (exactly 64 hex chars / 32
# bytes) encrypting every integration_connections.credentials_encrypted
# value (M-Pesa/Paystack/Airtel/Flutterwave/PesaPal API secrets). Was
# undocumented here before 2026-07-25 despite being required — connecting
# any payment integration throws without it. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=
REDIS_URL=redis://localhost:6379
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev_master_key_change_me

# AI/ML
AI_ML_SERVICE_URL=http://localhost:8000
AI_ML_SERVICE_SECRET=dev_internal_ai_ml_secret_change_me
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Payments
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Messaging
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
AFRICAS_TALKING_API_KEY=

# Product analytics
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

